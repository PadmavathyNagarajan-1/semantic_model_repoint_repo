		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source = ```
				ADDCOLUMNS (CALENDAR(MIN(Financial_Data[Date]),MAX(Financial_Data[Date])),
					"Year", YEAR([Date]), 
					"MonthNo", MONTH([Date]), 
					"Month", FORMAT([Date],"mmm"),
				    "Month (M)", LEFT(FORMAT([Date],"mmm"),1) & REPT(UNICHAR(8203),MONTH([Date])),
					"Quarter", FORMAT([Date],"\QQ"),
				    "QuarterNo", QUARTER([Date]), 
				    "Half Year" ,IF ( MONTH ( [Date] ) <= 6, "H1", "H2" ))
				```

	annotation PBI_Id = c89f22049cfd487cac64dde7321feda4

